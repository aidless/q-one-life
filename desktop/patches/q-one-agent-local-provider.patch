+    def test_builtin_local_openai_compatible_contract(self):
+        token = "local-session-token"
+        config = {
+            "local_url": "http://127.0.0.1:45678/v1",
+            "local_model": "Qwen3-0.6B-Q8_0",
+            "local_token": token,
+        }
+
+        def handler(request):
+            self.assertEqual(request.headers["authorization"], "Bearer " + token)
+            self.assertTrue(str(request.url).endswith("/v1/chat/completions"))
+            body = json.loads(request.content)
+            self.assertEqual(body["model"], "Qwen3-0.6B-Q8_0")
+            self.assertEqual(body["response_format"]["type"], "json_schema")
+            schema = body["response_format"]["json_schema"]["schema"]
+            self.assertEqual(schema["required"], ["option_id", "confidence", "rationale"])
+            return httpx.Response(
+                200,
+                json={
+                    "choices": [{"message": {"content": json.dumps(GOOD)}}],
+                    "usage": {"prompt_tokens": 12, "completion_tokens": 8},
+                },
+            )
+
+        result = run_model(
+            DECISION,
+            "local",
+            config,
+            transport=httpx.MockTransport(handler),
+        )
+        self.assertEqual(result.provider, "local")
+        self.assertEqual(result.model, "Qwen3-0.6B-Q8_0")
+        self.assertEqual(result.usage["prompt_tokens"], 12)
+
+    def test_builtin_local_provider_refuses_non_loopback_endpoint(self):
+        with self.assertRaisesRegex(ProviderError, "随机回环"):
+            run_model(
+                DECISION,
+                "local",
+                {
+                    "local_url": "https://example.invalid/v1",
+                    "local_model": "Qwen3-0.6B-Q8_0",
+                    "local_token": "token",
+                },
+            )
+
