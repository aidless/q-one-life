@article{zhang2026blindcurator,
  title   = {The Blind Curator: How a Biased Judge Silently Disables Skill Retirement in Self-Evolving Agents},
  author  = {Zhang, Xing and Cui, Yanwei and Wang, Guanghui and Li, Ziyuan and Qiu, Wei and Zhu, Bing and He, Peiyang},
  journal = {arXiv preprint arXiv:2607.07436},
  year    = {2026},
  note    = {cs.AI; submitted 8 Jul 2026. Direct predecessor of our threat model: shows biased LLM judge silently disables a downstream curator past a sharp false-pass threshold. Submitted within 3 days of our draft; we cite it as the closest contemporaneous evidence that the verifier-capture problem is timely.}
}

@article{leung2026rubricllm,
  title   = {Do You Need a Frontier Model as a Citation Verifier? Benchmarking Rubric LLMs for Deep-Research Source Attribution},
  author  = {Leung, Ethan and Lumer, Elias and Feld, Corey and Huber, Austin and Subbiah, Vamse Kumar and Paul, Kevin},
  journal = {arXiv preprint arXiv:2607.08700},
  year    = {2026},
  note    = {cs.CL; submitted 9 Jul 2026. Provides calibration numbers for 8 LLM judges across 1,248 rubric decisions; reports F1=0.908 (kappa=0.636) for GPT-5-mini on source-relevance; shows directional bias (pass-rate drift, FPR, FNR) differs across judges at matched F1. We use this as the most recent published rubric-judge benchmark and as motivation for capture-resilient aggregation.}
}

@article{cui2026edo,
  title   = {Ensemble Diversity Optimization for Subjective Supervision},
  author  = {Cui, Xia and Huang, Ziyi and Abeynayake, N. R.},
  journal = {arXiv preprint arXiv:2607.08493},
  year    = {2026},
  note    = {cs.LG; submitted 9 Jul 2026. Jointly optimizes ensemble weights, effective cardinality, and calibration via Gumbel-Softmax + signed diversity regularizer. Reduces cross-entropy 40-78% vs Soft-CE / Soft-MD / Top-5 Voting / WEL baselines. We cite as the most recent ensemble-with-calibration baseline; CRV differs by operating under an explicit adversarial (capture) model rather than a passive disagreement model.}
}

